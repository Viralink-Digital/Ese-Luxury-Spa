# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# MySQL running in Docker Desktop (mapped to port 3307)

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=esecosmetics_db_access_secret_32_chars_minimum_value
JWT_REFRESH_SECRET=esecosmetics_db_refresh_secret_32_chars_minimum_value
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─────────────────────────────────────────
# REDIS (Optional - system will work without Redis)
# ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ─────────────────────────────────────────
# TEXTBEE SMS OTP
# ─────────────────────────────────────────
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# ─────────────────────────────────────────
# KORAPAY PAYMENT GATEWAY
# ─────────────────────────────────────────
KORAPAY_PUBLIC_KEY=pk_live_your_korapay_public_key
KORAPAY_SECRET_KEY=sk_live_your_korapay_secret_key
KORAPAY_WEBHOOK_SECRET=your_korapay_webhook_secret
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# ─────────────────────────────────────────
# FILE UPLOADS
# ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# ─────────────────────────────────────────
# OTP SETTINGS
# ─────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────
# LOYALTY
# ─────────────────────────────────────────
POINTS_PER_NAIRA=1
NAIRA_PER_POINT=0.5
REFERRAL_BONUS_POINTS=500

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100